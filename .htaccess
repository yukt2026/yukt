# ==========================================================================
# YUKT IT SOLUTIONS — Production Apache Configuration (.htaccess)
# ==========================================================================

# 1. Prevent Directory Browsing & Configure 404
Options -Indexes
ErrorDocument 404 /404.php

# 2. Canonical URLs & 301 Redirects
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS on live domain
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^(www\.)?yukt\.online$ [NC]
    RewriteRule ^(.*)$ https://yukt.online/$1 [R=301,L]

    # Force non-www on live domain
    RewriteCond %{HTTP_HOST} ^www\.yukt\.online$ [NC]
    RewriteRule ^(.*)$ https://yukt.online/$1 [R=301,L]

    # Normalize direct /index.php requests to root on live domain
    RewriteCond %{HTTP_HOST} ^(www\.)?yukt\.online$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php [NC]
    RewriteRule ^index\.php$ https://yukt.online/ [R=301,L]
</IfModule>

# 3. Character Encoding & MIME Types
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddType image/svg+xml .svg .svgz
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType application/json .json
</IfModule>

# 4. Security & Anti-Cache Headers
<IfModule mod_headers.c>
    # Prevent MIME sniffing
    Header set X-Content-Type-Options "nosniff"

    # Prevent clickjacking / framing on external sites
    Header set X-Frame-Options "SAMEORIGIN"

    # Enable XSS filtering
    Header set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict unnecessary browser capabilities
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Prevent aggressive browser and CDN caching of dynamic HTML/PHP pages
    <FilesMatch "\.(php|html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, post-check=0, pre-check=0"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>
</IfModule>

# 4. Gzip / Brotli Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 5. Asset Cache Expiration
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Dynamic PHP Pages: No Cache
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"

    # Static Assets: 1 Year (Versioned with ?v= query string)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 6. Block Sensitive Files and Hidden Directories
<FilesMatch "^\.|\.(env|json|lock|sql|log|md|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow sitemap.xml, robots.txt, and favicon
<FilesMatch "^(sitemap\.xml|robots\.txt|favicon\.svg|manifest\.json)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>
